pipeline {
    agent any

    environment {
        NODE_ENV = 'test'
    }

    tools {
        nodejs 'node18'  // لازم يكون متضاف في Jenkins Tools
    }

    stages {

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm install'
                }
            }
        }

        stage('Unit Tests & Coverage (Jest)') {
            steps {
                dir('frontend') {
                    sh 'npm test -- --coverage --watchAll=false'
                }
            }
            post {
                always {
                    dir('frontend') {
                        archiveArtifacts artifacts: '**/coverage/**', fingerprint: true
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('frontend') {
                    withSonarQubeEnv('SonarQube') {
                        sh """
                        sonar-scanner \
                          -Dsonar.projectKey=frontend-react \
                          -Dsonar.projectName=Frontend-React \
                          -Dsonar.sources=src \
                          -Dsonar.tests=src \
                          -Dsonar.test.inclusions=src/**/*.test.js \
                          -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                          -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }
    }

    post {
        success {
            echo '✅ Frontend CI Pipeline completed successfully'
        }
        failure {
            echo '❌ Frontend CI Pipeline failed'
        }
    }
}
