pipeline {
    agent any

    tools {
        nodejs 'node18'   // الاسم اللي انت ضفته في Global Tool Configuration
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/mazenmostafa001/end-to-end-microservices-django-react-ci-.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        // باقي المراحل: Docker build & push أو deploy حسب مشروعك
    }

    post {
        success { echo "Pipeline succeeded ✅" }
        failure { echo "Pipeline failed ❌" }
    }
}
