pipeline {
    agent any

    environment {
        NODE_ENV = 'production'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '📥 Cloning repository...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo '📦 Installing npm dependencies...'
                sh '''
                  node -v
                  npm -v
                  npm install
                '''
            }
        }

        stage('Build') {
            steps {
                echo '🏗️ Building frontend...'
                sh '''
                  npm run build
                '''
            }
        }

        stage('Test (optional)') {
            when {
                expression { fileExists('package.json') }
            }
            steps {
                echo '🧪 Running tests...'
                sh '''
                  npm test -- --watch=false || true
                '''
            }
        }

    }

    post {
        success {
            echo '✅ Frontend pipeline finished successfully'
        }
        failure {
            echo '❌ Frontend pipeline failed'
        }
    }
}
