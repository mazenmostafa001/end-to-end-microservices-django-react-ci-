pipeline {
    agent any

    environment {
        SONAR_URL      = "http://100.28.1.22:9000"
        DOCKER_IMAGE   = "mazenmostafa429/frontend-react-demo"
        NEXUS_REPO_URL = "http://100.28.1.22:8081/repository/frontend-app/"
        NODE_ENV       = "production"
    }

    tools {
        nodejs 'node18'   // لازم يكون متضاف في Jenkins Tools
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/mazenmostafa001/end-to-end-microservices-django-react-ci-.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm install'
                }
            }
        }

        stage('Unit Tests & Coverage') {
            steps {
                dir('frontend') {
                    sh 'npm test -- --coverage --watchAll=false'
                }
            }
            post {
                always {
                    dir('frontend') {
                        archiveArtifacts artifacts: '**/coverage/**', fingerprint: true
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('frontend') {
                    withSonarQubeEnv('sonarqube') {
                        withCredentials([string(credentialsId: 'mazen-sonerqube', variable: 'SONAR_TOKEN')]) {
                            sh """
                            sonar-scanner \
                              -Dsonar.projectKey=frontend-react \
                              -Dsonar.projectName=Frontend-React \
                              -Dsonar.sources=src \
                              -Dsonar.tests=src \
                              -Dsonar.test.inclusions=src/**/*.test.js \
                              -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                              -Dsonar.login=$SONAR_TOKEN \
                              -Dsonar.host.url=$SONAR_URL
                            """
                        }
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir('frontend') {
                    script {
                        sh "docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} ."
                        docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
                            docker.image("${DOCKER_IMAGE}:${BUILD_NUMBER}").push()
                        }
                    }
                }
            }
        }

        stage('Deploy via Argo CD') {
            steps {
                withCredentials([string(credentialsId: 'argocd-token', variable: 'ARGO_TOKEN')]) {
                    sh """
                    argocd login <ARGOCD_SERVER> --username admin --password \$ARGO_TOKEN --insecure
                    argocd app sync frontend-react-demo
                    """
                }
            }
        }

    }

    post {
        success {
            echo "✅ Pipeline completed successfully"
        }
        failure {
            echo "❌ Pipeline failed – check logs"
        }
    }
}
